{
  "openapi": "3.1.0",
  "info": {
    "title": "Pearl Oasis Restaurant API",
    "version": "1.0.0",
    "description": "HTTP API for checking server health, managing food pickup/delivery orders, and managing table reservations at Pearl Oasis Restaurant in Kohat, Pakistan."
  },
  "servers": [
    {
      "url": "https://pearl-oasis.ai.studio",
      "description": "Pearl Oasis production web application"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check API service availability",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" }
                  },
                  "required": ["ok"]
                }
              }
            }
          }
        }
      }
    },
    "/api/orders": {
      "get": {
        "operationId": "listOrders",
        "summary": "List recent food orders",
        "responses": {
          "200": {
            "description": "Array of stored food orders"
          }
        }
      },
      "post": {
        "operationId": "createOrder",
        "summary": "Create a new pickup or delivery food order",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["fulfillmentType", "customer", "items"],
                "properties": {
                  "fulfillmentType": { "type": "string", "enum": ["delivery", "pickup"] },
                  "displayDate": { "type": "string" },
                  "displayTime": { "type": "string" },
                  "customer": {
                    "type": "object",
                    "required": ["name", "phone"],
                    "properties": {
                      "name": { "type": "string" },
                      "phone": { "type": "string" },
                      "notes": { "type": "string" }
                    }
                  },
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "object" }
                  },
                  "subtotal": { "type": "number" },
                  "deliveryFee": { "type": "number" },
                  "grandTotal": { "type": "number" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Order created successfully" },
          "400": { "description": "Invalid order payload" }
        }
      }
    },
    "/api/orders/{reference}": {
      "get": {
        "operationId": "getOrderByReference",
        "summary": "Fetch a food order by its reference code",
        "parameters": [
          {
            "name": "reference",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Order found" },
          "404": { "description": "Order not found" }
        }
      }
    },
    "/api/bookings": {
      "get": {
        "operationId": "listBookings",
        "summary": "List table reservations",
        "responses": {
          "200": { "description": "Array of stored table bookings" }
        }
      },
      "post": {
        "operationId": "createBooking",
        "summary": "Create a new table reservation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["totalGuests", "customer"],
                "properties": {
                  "bookingDate": { "type": "string" },
                  "displayTime": { "type": "string" },
                  "totalGuests": { "type": "integer", "minimum": 1 },
                  "hallPreference": { "type": "string" },
                  "customer": {
                    "type": "object",
                    "required": ["name", "phone"],
                    "properties": {
                      "name": { "type": "string" },
                      "phone": { "type": "string" },
                      "specialRequests": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Booking created successfully" },
          "400": { "description": "Invalid booking payload" }
        }
      }
    },
    "/api/bookings/{reference}": {
      "get": {
        "operationId": "getBookingByReference",
        "summary": "Fetch a table reservation by its reference code",
        "parameters": [
          {
            "name": "reference",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Booking found" },
          "404": { "description": "Booking not found" }
        }
      }
    }
  }
}
